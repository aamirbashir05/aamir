{
  "manifest_version": 3,
  "name": "VeoPilot — Text to Image to Video",
  "version": "0.2.0",
  "description": "Batch automation for Google Flow (VEO + Nano Banana): apne prompts se text→image, phir image→video, auto 1080p download ek folder me. Universal — jise bhi bulk text-to-image + image-to-video chahiye.",
  "permissions": ["storage", "downloads", "scripting", "sidePanel", "tabs"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "VeoPilot — Text to Image to Video",
    "default_popup": "panel.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "panel.html" }
}
