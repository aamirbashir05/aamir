{
  "manifest_version": 3,
  "name": "Drama Studio — Veo Copilot",
  "version": "0.1.0",
  "description": "Khaleeji drama shorts: story se 6-scene prompts banao, phir Veo/Flow pe best-effort auto image+video+download.",
  "permissions": ["storage", "downloads", "scripting", "sidePanel", "tabs"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Drama Studio — Veo Copilot" },
  "side_panel": { "default_path": "panel.html" }
}
